PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/algoprep
JWT_ACCESS_SECRET=algoprep_access_secret_super_secure_key_2026_jwt
JWT_REFRESH_SECRET=algoprep_refresh_secret_super_secure_key_2026_jwt
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Set initial password for admin@algoprep.com when running seed script. If omitted, a random password is generated and logged once.
ADMIN_SEED_PASSWORD=
NODE_ENV=development

# Reverse proxy hops to trust (Render = 1). Ensures rate limiting uses the real client IP.
TRUST_PROXY=1
# Rate limits (optional; defaults shown)
RATE_LIMIT_GENERAL_MAX=1000      # per user (IP fallback) per 15 minutes
RATE_LIMIT_AUTH_MAX=20           # login/signup per IP per 15 minutes
RATE_LIMIT_REFRESH_MAX=60        # token refresh per IP per 15 minutes
RATE_LIMIT_SAVE_PER_MIN=60       # exam autosave per user per minute
RATE_LIMIT_SUBMIT_PER_MIN=10     # exam submit per user per minute
