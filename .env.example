PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/algoprep
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=your_super_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_min_32_chars

# Gemini AI Models & Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro
GEMINI_EMBED_MODEL=text-embedding-004
EMBED_DIMENSIONS=768

# Optional external curation APIs
YOUTUBE_API_KEY=
TAVILY_API_KEY=

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional Cloudinary (for raw syllabus/slide storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed admin password
ADMIN_SEED_PASSWORD=
NODE_ENV=development
RUN_WORKERS=true

# Reverse proxy hops to trust (Render = 1). Ensures rate limiting uses the real client IP.
TRUST_PROXY=1
RATE_LIMIT_GENERAL_MAX=1000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_SAVE_PER_MIN=60
RATE_LIMIT_SUBMIT_PER_MIN=10
